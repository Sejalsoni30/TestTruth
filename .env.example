# TestTruth Environment Configuration

# Server Ports
PORT=5000
FRONTEND_PORT=3000
ANALYSIS_ENGINE_PORT=8000

# Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Database
# If MONGO_URI is omitted or left empty, TestTruth will auto-spawn an in-memory MongoDB instance for local zero-config runs.
MONGO_URI=mongodb://localhost:27017/testtruth

# Analysis Engine Service
ANALYSIS_ENGINE_URL=http://localhost:8000

# Sandbox Security Configuration
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MAX_MEMORY_MB=512
USE_DOCKER_SANDBOX=false

# AI Provider Configuration (Provider-agnostic)
# Supported providers: gemini, openai, anthropic, ollama, or none (Deterministic Mode)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_ENDPOINT=

